# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Environment / secrets (never commit)
.env
.env.*
!.env.example

# Uploads are user-provided data — never commit
data/uploads/

# Demo/synthetic sample images ARE committed: they are small, read-only assets
# required for the built-in demo/synthetic verification cases to run in a fresh
# production container (no personal or sensitive data).
!data/samples/
!data/samples/*.png

# Runtime SQLite database
data/*.db

# Local runtime logs
backend/server.log
*.log

# Frontend build artifacts
node_modules/
dist/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

data/mongodb/
mongodb/mongod.exe
mongodb/mongodb.zip
data/mongodb/
