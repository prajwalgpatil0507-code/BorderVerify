# Zynovix BorderVerity - environment configuration
# Copy to .env and adjust. All values have safe local defaults.

# --- App ---
APP_NAME=Zynovix BorderVerity
API_PREFIX=/api
# Change in production - never ship the default in a real deployment.
SECRET_KEY=sih-zynovix-demo-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# Defaults to a local SQLite file at data/border_verify.db
# DATABASE_URL=sqlite:///../data/border_verify.db

# --- MongoDB (SIH SYNTHETIC DEMO DATABASE: live verification reference data) ---
# The verification pipeline looks up passport / visa / watchlist / identity
# records here. It is a SYNTHETIC demo dataset, NOT a government database.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=borderverify

# --- Uploads / security ---
MAX_UPLOAD_MB=15

# --- Risk engine thresholds ---
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=61

# --- Expiry ---
EXPIRING_SOON_DAYS=180

# --- Face ---
FACE_MATCH_THRESHOLD=0.62
FACE_REVIEW_THRESHOLD=0.78

# --- Offline ---
OFFLINE_MODE=true
