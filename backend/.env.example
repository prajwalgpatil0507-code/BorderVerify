# Zynovix BorderVerity — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` (local) and fill in real values. In production the
# same variables are set as environment variables on the hosting platform.
#
#   cp .env.example .env
#
# NEVER commit the real `.env`. Keep secrets out of source control.

# --- App ---
APP_NAME=Zynovix BorderVerity
API_PREFIX=/api
# !! REQUIRED IN PRODUCTION — set a long random value; never ship the default.
SECRET_KEY=sih-zynovix-demo-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Bind address / port for `python -m app.main` (container hosts set PORT).
HOST=0.0.0.0
PORT=8000
RELOAD=false

# --- CORS ---
# Comma-separated list of allowed frontend origins. The SPA and API are usually
# served from the SAME origin, so "*" works locally. If you host the frontend on
# a separate domain, list it here, e.g.:
#   CORS_ORIGINS=https://my-app.onrender.com
CORS_ORIGINS=*

# --- Runtime directories ---
# DATA_DIR holds user uploads + the SQLite database. Default is project/data.
# In production point this at a PERSISTENT volume so uploads/results survive
# restarts, e.g. DATA_DIR=/app/data (when a persistent disk is mounted there).
# DATA_DIR=../data
# UPLOAD_DIR=../data/uploads
# SAMPLE_DIR holds committed demo/synthetic sample images (read-only assets).
# SAMPLE_DIR=../data/samples

# --- Database ---
# Defaults to a local SQLite file at data/border_verify.db. SQLite is used for
# auth sessions / verification-history persistence (offline-capable).
# DATABASE_URL=sqlite:///../data/border_verify.db

# --- MongoDB (SIH SYNTHETIC DEMO DATABASE: live verification reference data) ---
# The verification pipeline looks up passport / visa / watchlist / identity
# records here. It is a SYNTHETIC demo dataset, NOT a government database.
# REQUIRED IN PRODUCTION — set this to your cloud MongoDB (Atlas) connection
# string. If it is unreachable the app keeps working (falls back to offline mode).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=borderverify
MONGODB_CONNECT_TIMEOUT_MS=5000

# --- Uploads / security ---
MAX_UPLOAD_MB=15

# --- Auth / demo officer ---
# Pre-seeded demo account. Change these in production.
DEMO_USERNAME=officer
DEMO_PASSWORD=SIH@2026Demo
DEMO_NAME=Demo Officer

# --- Risk engine thresholds ---
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=61

# --- Expiry ---
EXPIRING_SOON_DAYS=180

# --- Face ---
FACE_MATCH_THRESHOLD=0.62
FACE_REVIEW_THRESHOLD=0.78
# Path to the pre-trained ArcFace embedding model (optional). When present the
# deep embedding replaces the heuristic face matcher; it is NOT committed.
# FACE_EMBEDDING_MODEL=../backend/arcface_w600k_r50.onnx

# --- Gemini (optional AI-assisted document analysis) ---
# NOT COMMITTED. When empty/absent the AI layer is disabled and the normal
# pipeline is used unchanged. Gemini never blocks a verification.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_S=6

# --- Image processing bounds ---
OCR_MAX_DIM=1800
OCR_UPSCALE_DIM=900
TAMPER_MAX_DIM=1200

# --- Verification request safety ---
VERIFY_TIMEOUT_S=30

# --- Offline ---
# "true" keeps the app fully usable without live government/Mongo integration.
OFFLINE_MODE=true
