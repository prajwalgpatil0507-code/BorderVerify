# ===========================================================================
# Zynovix BorderVerity — environment configuration (TEMPLATE)
# ===========================================================================
# Copy to `.env` locally:   cp .env.example .env
#
# This file is committed to the repo as a TEMPLATE ONLY. It contains variable
# NAMES with EMPTY values — it never contains real secrets. Fill in real values
# in your own `.env` (local) and in your backend host's environment variables.
# NEVER commit the real `.env` or real API keys / passwords.
#
#   MONGODB_URI=your_mongodb_connection_string
#   GEMINI_API_KEY=your_gemini_api_key
#   SECRET_KEY=your_secret_key
# ===========================================================================

# ---- App -----------------------------------------------------------------
APP_NAME=Zynovix BorderVerity
API_PREFIX=/api

# JWT signing key. MUST be a long random value in production (Render auto-generates it).
SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bind address / port for `python -m app.main` (container hosts set $PORT).
HOST=0.0.0.0
PORT=8000
RELOAD=false

# ---- CORS ----------------------------------------------------------------
# Comma-separated list of origins allowed to call this API. For the GitHub Pages
# frontend, include it exactly:  https://prajwalgpatil0507-code.github.io
# Also allow local dev origins:   http://127.0.0.1:5500,http://localhost:5500
# (A frontend served by FastAPI on the same origin needs no CORS entry.)
CORS_ORIGINS=

# ---- Database ------------------------------------------------------------
# Defaults to a local SQLite file (offline/fallback auth + history).
DATABASE_URL=

# MongoDB (the durable verification / reference store). REQUIRED in production.
MONGODB_URI=
MONGODB_DATABASE=borderverify
MONGODB_CONNECT_TIMEOUT_MS=5000

# ---- Uploads / security --------------------------------------------------
MAX_UPLOAD_MB=15

# ---- Auth / demo officer -------------------------------------------------
# App ships safe internal defaults (officer / SIH@2026Demo). Set real values here.
DEMO_USERNAME=
DEMO_PASSWORD=
DEMO_NAME=Demo Officer

# ---- Gemini (optional AI-assisted document analysis) ---------------------
# Leave empty to keep the AI layer off until you have a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_S=6

# ---- Risk engine thresholds ---------------------------------------------
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=61
EXPIRING_SOON_DAYS=180
FACE_MATCH_THRESHOLD=0.62
FACE_REVIEW_THRESHOLD=0.78
OCR_CONFIDENCE_THRESHOLD=0.5

# ---- Image processing bounds --------------------------------------------
OCR_MAX_DIM=1800
OCR_UPSCALE_DIM=900
TAMPER_MAX_DIM=1200

# ---- Verification request safety ----------------------------------------
VERIFY_TIMEOUT_S=30

# ---- Offline -------------------------------------------------------------
OFFLINE_MODE=true

# ---- Frontend API base (configured in frontend/index.html) ---------------
# The frontend reads window.BV_API_URL (in frontend/index.html), not this file.
# Kept here only as documentation of the single place the browser reads the backend.
API_BASE_URL=
